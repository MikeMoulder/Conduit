# STOCKPILOT environment template.
# Copy to .env.local and fill in. .env.local is gitignored and must never be committed.

# --- Pyth ---
# Hermes requires an API key as of 2026-08-26. Get a free one:
#   1. Sign up at https://pythdata.app (Pyth Terminal, no credit card)
#   2. Click "View your API key"
# This key is SERVER ONLY. It is never exposed to the browser. Pyth's own docs are
# explicit that frontends must not embed it, so all Pyth calls go through our API routes.
PYTH_API_KEY=

# Hermes base URL. Override only if using a self hosted instance.
PYTH_HERMES_URL=https://hermes.pyth.network

# --- Solana ---
# Devnet RPC. A dedicated endpoint is strongly preferred over the public one,
# which rate limits getProgramAccounts and similar calls.
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_CLUSTER=devnet

# --- Agents ---
# Used by the research, bull, bear, risk and portfolio manager pipeline.
ANTHROPIC_API_KEY=
