# STOCKPILOT environment template.
# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Pyth ---
# Hermes requires an API key as of 2026-08-26. Get a free one:
#   1. Sign up at https://pythdata.app (Pyth Terminal, no credit card)
#   2. Click "View your API key"
# This key is SERVER ONLY. It is never exposed to the browser. Pyth's own docs are
# explicit that frontends must not embed it, so all Pyth calls go through our API routes.
PYTH_API_KEY=

# Hermes base URL. Override only if using a self hosted instance.
PYTH_HERMES_URL=https://hermes.pyth.network

# --- Solana ---
# Devnet RPC. A dedicated endpoint is strongly preferred over the public one,
# which rate limits getProgramAccounts and similar calls.
#
# SERVER ONLY, like the keys above. The browser never receives this URL. It
# calls /api/rpc on our own origin, which forwards to this endpoint through a
# method allowlist, so a URL carrying an API key stays on the server.
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_CLUSTER=devnet

# The cluster name the browser is allowed to know, used to build explorer links
# that match the chain the server writes to. Not a secret, which is why this one
# is prefixed NEXT_PUBLIC_ and the RPC URL above is not. Keep it equal to
# SOLANA_CLUSTER or the interface will link to the wrong chain.
NEXT_PUBLIC_SOLANA_CLUSTER=devnet

# --- Agent identity ---
# The keypair that signs propose_rebalance, and nothing else. The agent is a
# separate actor from the owner, which is the point of the whole design: the
# owner holds authority over the mandate, the agent holds one instruction, and
# the difference is enforced by which key signs.
#
# Do not fill this in by hand. Run, from app/:
#   npm run agent:keypair
# It generates the key, writes it here and prints only the public key.
#
# Server only. This key can move no funds. Its only power is to submit a
# proposal the program will then check against the mandate.
AGENT_SECRET_KEY=

# --- Agents ---
# Google Gemini powers the research, bull, bear, risk and portfolio manager
# pipeline. Create a key at https://aistudio.google.com/apikey
# Server only, same as the Pyth key. It is never exposed to the browser.
GEMINI_API_KEY=

# Preferred model. The client walks a ladder and falls back automatically, so
# this is a preference rather than a hard requirement.
#
# Verified 2026-09-21 against a free key: the entire gemini-2.5 family returns
# 404 "no longer available to new users", the pro tier returns 429 on quota, and
# several flash models return intermittent 503. gemini-3.1-flash-lite answered
# reliably with schema valid output, so it is the default floor.
GEMINI_MODEL=gemini-3.1-flash-lite

# Devnet faucet key, base58 or JSON array. Pays demo cash into portfolios.
FAUCET_SECRET_KEY=

# Optional. Autopilot decisions sent to Telegram. Create a bot with @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
