# Normalize line endings on commit, check out native on Windows
* text=auto

# Force LF for files consumed by toolchains that dislike CRLF
*.sh text eol=lf
*.rs text eol=lf
*.toml text eol=lf

# Treat lockfiles as generated in diffs
package-lock.json linguist-generated=true -diff
Cargo.lock linguist-generated=true -diff

# Cargo writes LF and the host that builds the program is Linux, so keeping
# the checkout LF avoids a file that differs between the two machines that
# compile it.
Cargo.lock text eol=lf
